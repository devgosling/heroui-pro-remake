    "@tiptap/suggestion": ">=3.0.0",
    "embla-carousel-react": ">=8.0.0",
    "maplibre-gl": ">=5.0.0",
    "marked": ">=15.0.0",
    "react": ">=19.0.0",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-dom": ">=19.0.0",
